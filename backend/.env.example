PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/foodgarden
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# ── Email (Gmail SMTP via Nodemailer) ──────────────────────────
# 1. Turn on 2-Step Verification on the Gmail account you'll send from:
#    https://myaccount.google.com/security
# 2. Create an App Password:
#    https://myaccount.google.com/apppasswords
#    (Choose "Mail" as the app — Google gives you a 16-character password)
# 3. Put that Gmail address and the 16-char App Password below.
#    Do NOT use your normal Gmail login password — it will not work
#    and Google will block the connection.
EMAIL_USER=youraddress@gmail.com
EMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_FROM_NAME=Food Garden

# OTP settings
OTP_EXPIRY_MINUTES=10

# Any signup using this email is automatically granted the admin role
ADMIN_EMAIL=shabbirsohail33@gmail.com
